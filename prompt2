def create_motion_kernel(length, angle):
    """创建运动模糊核"""
    kernel_size = max(3, length * 2 + 1)
    kernel = np.zeros((kernel_size, kernel_size))
    center = kernel_size // 2
    angle_rad = np.deg2rad(angle)
    cos_val = np.cos(angle_rad)
    sin_val = np.sin(angle_rad)
    
    for i in range(-length, length + 1):
        x = int(round(i * cos_val))
        y = int(round(i * sin_val))
        if 0 <= center + y < kernel_size and 0 <= center + x < kernel_size:
            kernel[center + y, center + x] = 1
    
    kernel_sum = np.sum(kernel)
    if kernel_sum > 0:
        kernel = kernel / kernel_sum
    return kernel

def estimate_motion_blur_spectrum(blurred_img):
    """方法1: 使用频谱分析估计运动模糊参数"""
    # 转为灰度图
    if len(blurred_img.shape) == 3:
        gray = cv2.cvtColor(blurred_img, cv2.COLOR_BGR2GRAY)
    else:
        gray = blurred_img.copy()
    
    # 计算傅里叶变换
    f = np.fft.fft2(gray)
    fshift = np.fft.fftshift(f)
    magnitude_spectrum = np.log(np.abs(fshift) + 1)
    
    # 归一化频谱以增强对比度
    magnitude_spectrum_norm = (magnitude_spectrum - np.min(magnitude_spectrum)) / (np.max(magnitude_spectrum) - np.min(magnitude_spectrum)) * 255
    magnitude_spectrum_norm = magnitude_spectrum_norm.astype(np.uint8)
    
    # 应用阈值处理，以突显低频区域中的线型特征
    _, thresh = cv2.threshold(magnitude_spectrum_norm, 127, 255, cv2.THRESH_BINARY_INV)
    
    # 使用霍夫变换检测线条
    lines = cv2.HoughLines(thresh, 1, np.pi/180, 50)
    
    if lines is not None and len(lines) > 0:
        # 计算所有线的平均值
        sum_angle = 0
        count = 0
        
        for line in lines:
            rho, theta = line[0]
            # 转换角度确保在0-180度范围内
            angle_deg = (theta * 180 / np.pi) % 180
            
            # 只考虑接近垂直于运动方向的线
            if 45 <= angle_deg <= 135:
                sum_angle += angle_deg
                count += 1
        
        if count > 0:
            # 计算平均角度，然后旋转90度得到运动方向
            avg_angle = sum_angle / count
            motion_angle = (avg_angle - 90) % 180
            
            # 根据频谱中线的长度估计模糊核的长度
            # 这是一个简化的估计方法
            line_length = min(40, max(5, thresh.shape[0] // 15))
            
            return line_length, motion_angle
    
    # 默认返回值
    return 10, 0

def estimate_motion_blur_gradient(blurred_img):
    """方法2: 使用梯度分析估计运动模糊参数"""
    # 转为灰度图
    if len(blurred_img.shape) == 3:
        gray = cv2.cvtColor(blurred_img, cv2.COLOR_BGR2GRAY)
    else:
        gray = blurred_img.copy()
    
    # 应用边缘检测
    edges = cv2.Canny(gray, 100, 200)
    
    # 计算梯度
    grad_x = cv2.Sobel(gray, cv2.CV_64F, 1, 0, ksize=3)
    grad_y = cv2.Sobel(gray, cv2.CV_64F, 0, 1, ksize=3)
    
    # 计算梯度方向和强度
    magnitude = np.sqrt(grad_x**2 + grad_y**2)
    direction = np.arctan2(grad_y, grad_x) * 180 / np.pi
    
    # 创建方向直方图
    hist, bins = np.histogram(direction.flatten(), bins=36, range=(-180, 180), weights=magnitude.flatten())
    
    # 找到主要方向（模糊方向垂直于边缘方向）
    main_direction_idx = np.argmax(hist)
    main_direction = bins[main_direction_idx] + 90  # 正交方向
    if main_direction > 180:
        main_direction -= 360
    
    # 估计长度 - 使用自相关分析
    # 沿主方向进行自相关分析
    correlation_length = estimate_blur_length_correlation(gray, main_direction)
    
    return correlation_length, main_direction % 180

def estimate_blur_length_correlation(img, direction):
    """估计沿指定方向的模糊长度"""
    # 简化的自相关分析
    direction_rad = np.deg2rad(direction)
    cos_val = np.cos(direction_rad)
    sin_val = np.sin(direction_rad)
    
    # 创建一个方向性滤波器
    size = 31
    x, y = np.mgrid[-size//2:size//2+1, -size//2:size//2+1]
    
    # 计算点到直线的距离
    dist = np.abs(-sin_val*x + cos_val*y)
    
    # 创建方向性滤波器
    directional_filter = np.exp(-0.5 * (dist**2) / 2)
    directional_filter = directional_filter / np.sum(directional_filter)
    
    # 应用滤波器
    filtered = ndimage.convolve(img.astype(float), directional_filter)
    
    # 计算原始图像和滤波后图像的差异
    diff = np.abs(img.astype(float) - filtered)
    
    # 根据差异估计模糊长度
    avg_diff = np.mean(diff)
    
    # 映射差异到长度 (这需要调整)
    length = max(3, min(30, int(20 / (avg_diff + 0.1))))
    
    return length

def estimate_motion_blur_radon(blurred_img):
    """方法3: 使用Radon变换估计运动模糊参数"""
    from skimage.transform import radon
    
    # 转为灰度图
    if len(blurred_img.shape) == 3:
        gray = cv2.cvtColor(blurred_img, cv2.COLOR_BGR2GRAY)
    else:
        gray = blurred_img.copy()
    
    # 应用边缘检测
    edges = cv2.Canny(gray, 50, 150)
    
    # 应用Radon变换
    theta = np.linspace(0., 180., max(gray.shape) // 2, endpoint=False)
    sinogram = radon(edges, theta=theta)
    
    # 找到最强的投影角度
    variance = np.var(sinogram, axis=0)
    angle_index = np.argmax(variance)
    angle = theta[angle_index]
    
    # 模糊方向与边缘方向垂直
    motion_angle = (angle + 90) % 180
    
    # 估计模糊长度
    # 使用投影的方差来估计长度
    max_var = np.max(variance)
    length = max(3, min(30, int(max_var / 1000)))
    
    return length, motion_angle

def blind_deconvolution_estimate(blurred_img, max_iter=10):
    """方法4: 使用简化的盲反卷积估计模糊核"""
    # 转为灰度图
    if len(blurred_img.shape) == 3:
        gray = cv2.cvtColor(blurred_img, cv2.COLOR_BGR2GRAY)
    else:
        gray = blurred_img.copy()
    
    # 缩小图像以加快处理速度
    scale_factor = 0.5
    small_gray = cv2.resize(gray, None, fx=scale_factor, fy=scale_factor)
    
    # 估计初始核大小和形状
    kernel_size = 15
    kernel = np.zeros((kernel_size, kernel_size))
    kernel[kernel_size//2, kernel_size//2-3:kernel_size//2+4] = 1/7  # 初始假设为水平模糊
    
    # 使用OpenCV的盲反卷积
    gray_float = small_gray.astype(np.float32) / 255.0
    kernel_float = kernel.astype(np.float32)
    
    # 迭代优化
    for i in range(max_iter):
        # 使用当前核进行反卷积
        restored = cv2.filter2D(gray_float, -1, kernel_float)
        
        # 增强边缘
        edges = cv2.Canny(np.uint8(restored*255), 100, 200)
        
        # 创建一个与核大小相同的临时图像
        temp_kernel = np.zeros_like(kernel_float)
        
        # 从边缘图像中提取中心区域作为新核的估计
        h, w = edges.shape
        center_y, center_x = h // 2, w // 2
        offset = kernel_size // 2
        
        # 确保提取区域不超出边界
        y_start = max(0, center_y - offset)
        y_end = min(h, center_y + offset + 1)
        x_start = max(0, center_x - offset)
        x_end = min(w, center_x + offset + 1)
        
        # 提取中心区域
        extract_h = y_end - y_start
        extract_w = x_end - x_start
        temp_y_start = max(0, offset - (center_y - y_start))
        temp_x_start = max(0, offset - (center_x - x_start))
        
        # 将提取的区域放入临时核
        temp_kernel[temp_y_start:temp_y_start+extract_h, 
                   temp_x_start:temp_x_start+extract_w] = edges[y_start:y_end, x_start:x_end]
        
        # 归一化
        if np.sum(temp_kernel) > 0:
            temp_kernel = temp_kernel / np.sum(temp_kernel)
        
        # 更新核
        kernel_float = 0.7 * kernel_float + 0.3 * temp_kernel
    
    # 分析核以提取长度和角度
    kernel_binary = (kernel_float > np.max(kernel_float) * 0.2).astype(np.uint8)
    
    # 找到非零元素的坐标
    y, x = np.nonzero(kernel_binary)
    
    if len(x) >= 2:
        # 计算主方向
        coords = np.column_stack((x, y)).astype(np.int32)
        vx, vy, x0, y0 = cv2.fitLine(coords, cv2.DIST_L2, 0, 0.01, 0.01)
        angle = np.arctan2(vy[0], vx[0]) * 180 / np.pi
        
        # 计算长度
        x_min, x_max = np.min(x), np.max(x)
        y_min, y_max = np.min(y), np.max(y)
        length = int(np.sqrt((x_max - x_min)**2 + (y_max - y_min)**2) / 2)
        
        return max(3, min(30, length)), angle % 180
    
    # 默认返回值
    return 10, 0
def wiener_filter(img, kernel, K=0.01):
    """
    应用维纳滤波去除图像模糊
    """
    # 转换为浮点数
    img = img.astype(float)
    kernel = kernel.astype(float)
    
    # 确保核的和为1
    if np.sum(kernel) != 0:
        kernel = kernel / np.sum(kernel)
    
    # 计算图像的傅里叶变换
    img_fft = fftpack.fft2(img)
    
    # 为核填充0使其与图像大小相同
    kernel_padded = np.zeros_like(img)
    kh, kw = kernel.shape
    kernel_padded[:kh, :kw] = kernel
    
    # 确保核居中
    kernel_padded = np.roll(kernel_padded, -kh//2, axis=0)
    kernel_padded = np.roll(kernel_padded, -kw//2, axis=1)
    
    # 计算PSF的傅里叶变换
    kernel_fft = fftpack.fft2(kernel_padded)
    
    # 维纳滤波公式
    kernel_fft_conj = np.conj(kernel_fft)
    denominator = np.abs(kernel_fft)**2 + K
    wiener_filter = kernel_fft_conj / denominator
    
    # 应用滤波器
    img_deconvolved = wiener_filter * img_fft
    
    # 反变换获取结果
    img_restored = np.abs(fftpack.ifft2(img_deconvolved))
    
    # 限制像素值范围为[0, 255]
    img_restored = np.clip(img_restored, 0, 255)
    
    return img_restored.astype(np.uint8)

def process_channel(channel, kernels):
    """处理单个颜色通道"""
    results = []
    for kernel in kernels:
        # 使用估计的核进行维纳滤波
        restored = wiener_filter(channel, kernel)
        results.append(restored)
    return results

