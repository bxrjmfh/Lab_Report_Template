    ])
    total_scores = np.sum(scores, axis=0)
    best_method_idx = np.argmax(total_scores)
    
    print(f"\n根据综合评分，最佳去模糊方法是: {kernel_names[best_method_idx]}")
    print(f"评分详情: {total_scores}")
    
    # 返回结果
    return {
        'blurred': blurred_img,
